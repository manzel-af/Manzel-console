# The console's settings. Copy to .env.local for development; on Vercel, set
# them under Project → Settings → Environment Variables.
#
# Only PUBLIC values belong here: the project URL and its anon key, the same
# two the app ships in every phone. Never put the service-role key, or any
# other secret, in the console.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public half of the Web Push key pair (alerts in the browser). The
# private half lives only in the Supabase edge function's secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
